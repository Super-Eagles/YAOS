{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When C++, QML, or project config files change, asks the agent to update the docs folder to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.cpp",
      "src/**/*.h",
      "qml/**/*.qml",
      "qmake/modules/*.pri",
      "CMakeLists.txt",
      "*.pro"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and update the documentation in the /docs folder if the change affects architecture, module structure, APIs, configuration, providers, channels, tools, or any other user-facing or developer-facing behavior. If there is no relevant docs entry, consider whether a new section should be added. Do not update docs for trivial or internal-only changes."
  }
}