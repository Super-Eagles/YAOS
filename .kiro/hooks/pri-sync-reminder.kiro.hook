{
  "enabled": true,
  "name": "PRI Sync Reminder",
  "description": "When a new C++ source or header is created, reminds the agent to add it to the matching .pri module file.",
  "version": "1.0.0",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "src/**/*.cpp",
      "src/**/*.h"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new C++ file was just created. Check which layer it belongs to (base, business, frontend, or daemon) based on its path under src/, then add it to the matching qmake/modules/*.pri file. Do not add it to CMakeLists.txt — CMake reads the .pri files automatically. Refer to the workflow.md steering for the layer-to-pri mapping."
  }
}
